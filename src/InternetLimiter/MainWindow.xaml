<Window x:Class="InternetLimiter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Limiter — ограничение скорости приложений"
        Height="640" Width="920" MinWidth="720" MinHeight="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить" Width="100" Height="26" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            <TextBlock Text="Фильтр:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" Height="26" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
        </DockPanel>

        <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Single" SelectionChanged="ProcessList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Приложение" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Процессов" DisplayMemberBinding="{Binding ProcessCount}" Width="80"/>
                    <GridViewColumn Header="Путь" DisplayMemberBinding="{Binding ExecutablePath}" Width="330"/>
                    <GridViewColumn Header="Лимит" DisplayMemberBinding="{Binding LimitText}" Width="110"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" Padding="10" Margin="0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedAppLabel" Text="Выберите приложение" FontWeight="Bold" Width="200" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Лимит:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="LimitBox" Width="80" Height="26" VerticalContentAlignment="Center" PreviewTextInput="LimitBox_PreviewTextInput"/>
                <ComboBox x:Name="UnitBox" Width="70" Margin="6,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="КБ/с"/>
                    <ComboBoxItem Content="МБ/с"/>
                </ComboBox>
                <Button x:Name="ApplyButton" Content="Применить" Width="100" Margin="14,0,0,0" Click="ApplyButton_Click" IsEnabled="False"/>
                <Button x:Name="RemoveButton" Content="Убрать лимит" Width="110" Margin="8,0,0,0" Click="RemoveButton_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="3" Margin="0,0,0,4">
            <GroupBox.Header>
                <DockPanel Width="860">
                    <TextBlock Text="Активные лимиты" FontWeight="Bold"/>
                    <Button Content="Убрать все" Width="90" Height="22" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="RemoveAllButton_Click"/>
                </DockPanel>
            </GroupBox.Header>
            <ListView x:Name="ActiveLimitsList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Приложение" DisplayMemberBinding="{Binding AppMatch}" Width="220"/>
                        <GridViewColumn Header="Лимит" DisplayMemberBinding="{Binding RateText}" Width="120"/>
                        <GridViewColumn Header="Политика" DisplayMemberBinding="{Binding PolicyName}" Width="240"/>
                        <GridViewColumn Header="" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить" Click="DeletePolicy_Click" Tag="{Binding PolicyName}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <TextBlock x:Name="StatusBar" Grid.Row="4" Margin="0,4,0,0" Foreground="#555" Text="Готово" TextWrapping="Wrap"/>
    </Grid>
</Window>
